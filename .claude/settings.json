{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git checkout -b *)",
      "Bash(git checkout -B *)",
      "Bash(git switch -c *)",
      "Bash(git switch -C *)",
      "Bash(git switch --create *)",
      "Bash(git worktree add *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git checkout -B *)",
      "PowerShell(git switch -c *)",
      "PowerShell(git switch -C *)",
      "PowerShell(git switch --create *)",
      "PowerShell(git worktree add *)"
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/tools/dev/Install-GitHooks.mjs\" >/dev/null 2>&1 || true",
            "timeout": 15,
            "statusMessage": "Verifying the no-new-branch git hooks..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/no-new-branch.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the no-new-branch rule..."
          }
        ]
      }
    ]
  }
}
