# These files are hashed or byte-compared by CI outside Git's own diff, so the
# working tree must match the committed bytes exactly. Without eol=lf a Windows
# checkout (core.autocrlf=true) rewrites them to CRLF and the contract-manifest,
# changelog-baseline and API-docs gates fail locally while passing in CI.
specs/api/openapi/** text eol=lf
docs/api/** text eol=lf
docs/api-changelog.md text eol=lf

# dotnet format evaluates the physical working-tree bytes. Pin C# to LF so the
# same format gate is reproducible on Windows (including core.autocrlf=true) and
# on the Linux GitLab runner.
*.cs text eol=lf

# NSwag owns these byte-for-byte outputs and currently emits trailing spaces.
# Keep drift enforcement exact while excluding only generated code from Git's
# handwritten whitespace diagnostics.
src/Ivr.Contracts/Generated/** -whitespace

# Asterisk runs these files inside Linux containers. Keep checksum manifests
# and shell entrypoints stable on Windows checkouts; WAV assets are binary.
deploy/lab/asterisk/*.sh text eol=lf
deploy/lab/asterisk/audio/SHA256SUMS text eol=lf
deploy/lab/asterisk/audio/manifest.txt text eol=lf
deploy/lab/asterisk/audio/*.wav binary

# CI gate scripts execute inside Linux containers and are also run straight from
# the working tree during local verification. Without eol=lf a Windows checkout
# rewrites them to CRLF and `sh` rejects the very first line as `set -eu\r`.
deploy/ci/scripts/*.sh text eol=lf
