!deploy/ci/fixtures/coverage/**
ci-artifacts/
# Local scratch build/test output (W-0105 era tooling wrote 246 MB here). Never committed.
.artifacts/
# SBOMs are regenerated by IT-IMG-SBOM-06 on every run; the CI job publishes them as build
# artifacts. Committing them would freeze a picture of images that move underneath it.
artifacts/sbom/
artifacts/observability/
.tools/
deploy/lab/.local-tools/

# Node / Next.js
**/node_modules/
**/.next/
admin-ui/out/
admin-ui/.env*
!admin-ui/.env.example
npm-debug.log*

# Local runtime data and secrets
.env
.env.*
!.env.example
.secrets/
pgdata/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

.codex-doc-memory

# W-0106 voice audition MP3. Source audio stays out of the repo (W-0104 precedent);
# only pinned PCM 8 kHz plus SHA-256 ever gets committed.
artifacts/w-0106-voice-audition/

# W-0122 model bundles and rendered speech are reproducible local/CI artifacts.
# Only pins, hashes, manifests and evidence metadata belong in Git.
artifacts/w-0122-models/
artifacts/w-0122-voice-audition/
artifacts/w-0122-fixed-speech/
**/__pycache__/
*.py[cod]
