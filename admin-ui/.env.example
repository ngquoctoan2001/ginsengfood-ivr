# Admin UI (P3-1 / W-0025) — local MOCK development only.
# Copy to `.env.local`. Never commit a real secret or a production endpoint.

# Base URL of Ivr.Api. Read on the server only; never exposed to the browser.
# IVR owns the 5005/3005/55433 range so it never collides with ginsengfood-ops-core
# (backend 5000, frontend 3000).
IVR_API_BASE_URL=http://127.0.0.1:5005

# Canonical execution mode key (governance §6). MOCK is the only mode in which
# the mock sign-in directory is reachable; every other value fails closed.
IVR_EXECUTION_MODE=MOCK

# HMAC key for the httpOnly session cookie. Minimum 32 characters.
# The value below is a placeholder, not a key. Generate a local one and keep it
# out of the repository; production key issuance is BLOCKED_EXTERNAL (G-AUTH / W-0006).
IVR_ADMIN_UI_SESSION_SECRET=replace-with-a-local-value-of-32-chars-or-more

# Displayed in the governance banner. V1 invariant: real customer calls are off.
REAL_CUSTOMER_CALL_ALLOWED=NO

# Environment label shown in the shell badge (dev | lab | staging | production).
IVR_ENVIRONMENT_LABEL=dev
