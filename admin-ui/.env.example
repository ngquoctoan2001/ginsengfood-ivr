# IVR Admin UI. Copy to `.env.local`; never commit a production endpoint.

# Base URL of Ivr.Api. Read on the server only; never exposed to the browser.
# IVR owns the 5005/3005/55433 range so it never collides with ginsengfood-ops-core
# (backend 5000, frontend 3000).
IVR_API_BASE_URL=http://127.0.0.1:5005

# Server-only service credentials. The browser never receives these values. Use the lowest tier
# required by each route; these local placeholders are not deployable secrets.
IVR_ADMIN_READ_TOKEN=dev-admin-read-token-not-a-real-secret
IVR_ADMIN_WRITE_TOKEN=dev-admin-write-token-not-a-real-secret
IVR_ADMIN_DANGER_TOKEN=dev-admin-danger-token-not-a-real-secret

# Stable Module 3 operator reference copied to X-Actor-Id for the local reference console.
IVR_ADMIN_ACTOR_ID=local-reference-operator

# Canonical execution mode key used by the API/runtime governance controls.
IVR_EXECUTION_MODE=MOCK

# Displayed in the governance banner. V1 invariant: real customer calls are off.
REAL_CUSTOMER_CALL_ALLOWED=NO

# Environment label shown in the shell badge (dev | lab | staging | production).
IVR_ENVIRONMENT_LABEL=dev
