# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# P3-1: the placeholder template is documentation, and holds no key.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# W-0124: CI installs this app with `npm ci` (deploy/ci/ui-qa.gitlab-ci.yml) and the
# committed lockfile is package-lock.json. A stray `pnpm` invocation bootstraps its own
# lockfile plus a pnpm-workspace.yaml carrying an unanswered `allowBuilds` placeholder,
# which then makes every later `pnpm` command fail and shows up as repo changes that are
# not the work in hand. Ignore both so the mistake stays local and self-correcting.
pnpm-lock.yaml
pnpm-workspace.yaml
