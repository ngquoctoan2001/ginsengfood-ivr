{
  "name": "ginsengfood-ivr-ci-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "openapi:lint": "redocly lint ../../specs/api/openapi/ivr-order-confirmation.v1.yaml ../../specs/api/openapi/order-core-ivr-callback.target-v1.yaml --config ../../.redocly.yaml",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "openapi:drift": "node scripts/openapi-contract-drift.mjs",
    "openapi:accept-reviewed-draft": "node scripts/openapi-contract-drift.mjs --accept-reviewed-draft",
    "test:openapi-negative": "node scripts/selftest-openapi.mjs",
    "test:config": "node scripts/ci-config-selftest.mjs",
    "docs:build": "node scripts/build-api-docs.mjs",
    "test:docs": "node scripts/docs-selftest.mjs",
    "traceability:write": "node scripts/generate-test-traceability.mjs",
    "test:traceability": "node scripts/generate-test-traceability.mjs --check",
    "test:review-gate": "node scripts/review-gate-selftest.mjs",
    "check:mr": "node scripts/check-mr-traceability.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@redocly/cli": "2.46.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "marked": "18.0.9",
    "yaml": "2.9.0"
  }
}
