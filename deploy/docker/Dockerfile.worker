# syntax=docker/dockerfile:1.7
# W-0043 / P7-1 — ivr-worker (DTS-04: three separate deployables).
#
# Bases pinned by digest, same reasoning as Dockerfile.api: a tag is a moving pointer, so a build
# that "passed the scan" could otherwise ship bits nobody scanned.
#
# W-0139: OpenTelemetry.AspNetCore instrumentation is registered by the shared observability
# composition code (and enabled only in the API), so the Worker assembly now references the
# Microsoft.AspNetCore.App shared framework even though it still opens no socket.
# Pinned to the 10.0.2xx band because global.json pins 10.0.201 with rollForward=latestPatch,
# which refuses a different feature band. Matching the repository rather than loosening
# global.json: the pin is there so every build uses the SDK the tests were run against.
ARG SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.203@sha256:6d7f69bc7bc9d4510ca255977b1f53ce52a79307e048a91450b2aecd63627cc3
ARG RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled@sha256:edec6ea65a92f432083a8f75fc3c18addd004015bbd4d523ce1d13e23b347008

FROM ${SDK_IMAGE} AS build
WORKDIR /src

COPY global.json Directory.Build.props ./
COPY src/Ivr.Domain/Ivr.Domain.csproj src/Ivr.Domain/packages.lock.json src/Ivr.Domain/
COPY src/Ivr.Contracts/Ivr.Contracts.csproj src/Ivr.Contracts/packages.lock.json src/Ivr.Contracts/
COPY src/Ivr.Infrastructure/Ivr.Infrastructure.csproj src/Ivr.Infrastructure/packages.lock.json src/Ivr.Infrastructure/
COPY src/Ivr.Worker/Ivr.Worker.csproj src/Ivr.Worker/packages.lock.json src/Ivr.Worker/
RUN dotnet restore src/Ivr.Worker/Ivr.Worker.csproj --locked-mode

COPY src/ src/
RUN dotnet publish src/Ivr.Worker/Ivr.Worker.csproj \
        --configuration Release \
        --no-restore \
        --output /app

FROM ${RUNTIME_IMAGE} AS final
WORKDIR /app
COPY --from=build /app .

ENV DOTNET_EnableDiagnostics=0 \
    IVR_EXECUTION_MODE=MOCK \
    IVR_ADAPTER_MODE=MOCK \
    REAL_CUSTOMER_CALL_ALLOWED=NO

# UID 1654 written out, not inherited. The chiseled base defines APP_UID and USER $APP_UID would
# resolve to the same number today, but the number then lives only in Microsoft's image while three
# things in this repository depend on its exact value: deployment-worker.yaml pins runAsUser,
# runAsGroup and fsGroup to 1654, deployment-api.yaml sets runAsNonRoot with no runAsUser and so
# needs a numeric UID readable from the image config, and deploy/docker/README.md documents 1654.
# A base that changed APP_UID would move the image and leave all three behind, silently.
# Dockerfile.tts already writes it out this way. CT-CI-11 keeps every USER line literal.
USER 1654:1654

# No EXPOSE and no HEALTHCHECK, deliberately.
#
# The worker does open one socket: WorkerHealthEndpoint (W-0043 section 2), a bare HttpListener on
# Ivr:Worker:Health (port 8081, /healthz by default) that reports each loop's last tick. The chart's
# liveness probe reads it, so the orchestrator that restarts the pod is the one that asks; a
# HEALTHCHECK here would be a second opinion Docker cannot act on in Kubernetes. (W-0356: this
# comment said the worker opened no socket, which stopped being true when the endpoint landed.)
ENTRYPOINT ["dotnet", "Ivr.Worker.dll"]
