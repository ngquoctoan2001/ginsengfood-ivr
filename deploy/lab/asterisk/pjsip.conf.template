[global]
type=global
user_agent=GinsengFood-IVR-Lab

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[LAB-A]
type=endpoint
transport=transport-udp
context=ivr-lab
disallow=all
allow=ulaw
allow=alaw
auth=LAB-A
aors=LAB-A
direct_media=no
; This profile publishes RTP only on Windows localhost. Advertise that same
; address so MicroSIP sends audio and RFC4733 DTMF through Docker's UDP map.
media_address=127.0.0.1
dtmf_mode=rfc4733
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[LAB-A]
type=auth
auth_type=userpass
username=LAB-A
password=__SIP_PASSWORD__

[LAB-A]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=15
