{
  "uid": "ivr-order-confirmation-slo",
  "title": "IVR Order Confirmation — SLO & health",
  "tags": [
    "ivr",
    "slo",
    "W-0041"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "hide": 0
      }
    ]
  },
  "description": "W-0041 / P6-2. Every panel names a metric that a production call site actually records; UT-DASH-PII-04 walks the expressions back to those call sites and fails if a panel outruns the instrumentation. No panel carries a per-customer or per-order dimension: ivr.correlation_id is trace-only, and as a metric label it would turn every request into its own time series.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Intake decisions by outcome",
      "description": "Decision mix at the single intake exit. Rejections rising without a matching rise in volume points upstream at Sales payloads, not at IVR.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (ivr_decision) (rate(ivr_intake_decisions_total[5m]))",
          "legendFormat": "{{ivr_decision}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Intake decision latency p95",
      "description": "Wall time from task receipt to decision, measured at the same exit as the decision itself so the two cannot drift apart.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ivr_task_intake_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Callback revalidate p95 by program (SLO: D-04, 5s)",
      "description": "D-04 fixes the objective at 5s. This is the synchronous hop the customer-facing confirmation inherits.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, ivr_program) (rate(ivr_result_callback_duration_seconds_bucket[5m])))",
          "legendFormat": "{{ivr_program}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Callback delivery outcome",
      "description": "Terminal delivery states from the outbox, including RETRY_EXHAUSTED which routes to admin review rather than to a pager.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (ivr_outcome) (rate(ivr_result_callbacks_total[5m]))",
          "legendFormat": "{{ivr_outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Callback transport vs semantic ACK, by contract",
      "description": "HTTP status and semantic ACK are separate questions: a 200 carrying a rejection is a failed confirmation with a healthy transport. Split by contract so the current Golden Hour compat path is never averaged together with target v1.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (ivr_callback_contract, ivr_http_status) (rate(ivr_result_callbacks_total[5m]))",
          "legendFormat": "{{ivr_callback_contract}} http {{ivr_http_status}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (ivr_callback_contract, ivr_ack_code) (rate(ivr_result_callbacks_total[5m]))",
          "legendFormat": "{{ivr_callback_contract}} ack {{ivr_ack_code}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Fail-closed holds by reason (DO-06)",
      "description": "Holding when a dependency cannot be proven healthy is designed behaviour. Read the proportion against intake volume, not the absolute count.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (ivr_reason_code) (rate(ivr_fail_closed_total[5m]))",
          "legendFormat": "{{ivr_reason_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Channel auto-disable, 10m window (DT-04)",
      "description": "DT-04 auto-disables a channel at three failures in ten minutes. The window here matches the rule so the panel and the page agree.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (ivr_reason_code) (increase(ivr_channel_quarantines_total[10m]))",
          "legendFormat": "{{ivr_reason_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Business outcome rate (ARCH-06 §1)",
      "description": "W-0041 declared these rates and could not draw them: ivr_call_results_total had no call site. It does now (ResultRepository, after commit). clamp_min keeps a division by an idle period from rendering as infinity, which reads like an incident rather than like silence. Runbook: docs/slo.md#business-outcome-rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum(rate(ivr_call_results_total{ivr_result_type=\"IVR_CONFIRMED\"}[15m])) / clamp_min(sum(rate(ivr_call_results_total[15m])), 0.0001)",
          "legendFormat": "confirm_rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ivr_call_results_total{ivr_result_type=\"IVR_CUSTOMER_CANCELLED\"}[15m])) / clamp_min(sum(rate(ivr_call_results_total[15m])), 0.0001)",
          "legendFormat": "cancel_rate",
          "refId": "B"
        },
        {
          "expr": "sum(rate(ivr_call_results_total{ivr_result_type=~\"IVR_NO_ANSWER_.*\"}[15m])) / clamp_min(sum(rate(ivr_call_results_total[15m])), 0.0001)",
          "legendFormat": "no_answer_rate",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Attempts dispatched vs results normalized",
      "description": "The two counters bracket the call path. A persistent gap means attempts are leaving the scheduler and not coming back as results — dispatch succeeding while normalization stalls, which no single counter can show. Runbook: docs/slo.md#attempt-result-gap",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum(rate(ivr_call_attempts_total[15m]))",
          "legendFormat": "attempts dispatched",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ivr_call_results_total[15m]))",
          "legendFormat": "results normalized",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Confirmation windows that closed uncalled (ARCH-06 §1)",
      "description": "A COUNT per hour, deliberately not a rate. The alert threshold is zero, so the question this panel answers is \"how many orders\", and a rate renders one lost order as 0.0003/s -- a number nobody reads as an order. The capacity model (W-0054) says the shipped pool covers the modelled peak, so anything above the floor here means a model assumption is wrong, not that the pool needs topping up. Runbook: docs/slo.md#capacity-deadline-missed",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum by (ivr_program) (increase(ivr_missed_deadline_total[1h]))",
          "legendFormat": "{{ivr_program}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Orders the retired trusted-skip would have skipped (OD-18)",
      "description": "A COUNT per hour, not a rate: the unit that matters is orders, and a rate renders one of them as a number nobody reads as an order. Every increment is an order Module 3 still marks with the old skip evidence and IVR now calls anyway -- the exact size of the behaviour change W-0123 could only infer, because no target database was reachable to count it. Zero confirms the inference. Non-zero is not an IVR fault and not an alert: it means M3 is still sending a producer-side signal it was asked to stop sending, and each one is a real extra call to a real customer. Runbook: docs/slo.md#legacy-skip-candidates",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "expr": "sum by (ivr_program) (increase(ivr_legacy_skip_candidate_total[1h]))",
          "legendFormat": "{{ivr_program}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
