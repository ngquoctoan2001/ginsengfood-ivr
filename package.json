{
  "name": "ginsengfood-ivr-local-dev",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "prepare": "node tools/dev/Install-GitHooks.mjs",
    "hooks:install": "node tools/dev/Install-GitHooks.mjs",
    "setup": "dotnet restore Ivr.sln --locked-mode && dotnet tool restore",
    "api:dev": "dotnet run --project src/Ivr.Api",
    "worker": "dotnet run --project src/Ivr.Worker",
    "docker:apps:stop": "docker compose -f docker-compose.dev.yml stop ivr-api ivr-worker",
    "db:up": "docker compose -f docker-compose.dev.yml up -d postgres",
    "db:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/Update-IvrDatabase.ps1",
    "db:migration:add": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/Add-IvrMigration.ps1",
    "db:migration:list": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/Get-IvrMigrations.ps1",
    "local:prepare": "pnpm docker:apps:stop && pnpm db:up && pnpm db:migrate",
    "dev:bootstrap": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/Invoke-DevBootstrap.ps1",
    "e2e:local": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/Invoke-LocalE2E.ps1",
    "e2e:local:keep": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/Invoke-LocalE2E.ps1 -KeepRunning",
    "e2e:mock": "node tools/dev/Invoke-LocalMockE2E.mjs",
    "sandbox:up": "docker compose -f docker-compose.dev.yml -f docker-compose.sandbox.yml up -d --build",
    "sandbox:reset": "docker compose -f docker-compose.dev.yml -f docker-compose.sandbox.yml down -v",
    "sandbox:examples": "node deploy/ci/scripts/sandbox-examples.mjs",
    "e2e:mock:smoke": "node tools/dev/Invoke-LocalMockE2E.mjs --rounds 2 --workers 1 --extended-every 2 --skip-faults"
  }
}
